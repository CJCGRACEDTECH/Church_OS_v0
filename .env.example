# Church OS — environment variables template
# Copy this file to .env and fill in real values.
# Never commit .env to version control.

# PostgreSQL connection string (required)
DATABASE_URL=postgresql://user:password@localhost:5432/churchos

# Secret used to sign session cookies (required, min 32 chars)
SESSION_SECRET=change-me-to-a-long-random-string

# Server port (optional, defaults to 8080)
PORT=8080

# Node environment: development | production | test
NODE_ENV=development

# Self-service signup target church slug.
# Keep this aligned with an existing churches.slug value.
DEFAULT_SIGNUP_CHURCH_SLUG=cjc-international

# Frontend destination after successful OAuth callback.
APP_BASE_URL=http://localhost:5173

# Admin invitation links expire after this many hours.
ADMIN_INVITE_TTL_HOURS=72

# Optional transactional email provider for admin invites.
# If RESEND_API_KEY is omitted, invite links are logged by the API server for local/Replit testing.
RESEND_API_KEY=
INVITE_EMAIL_FROM="Church OS <no-reply@example.com>"

# Stripe Giving
# Use Stripe-hosted Checkout/Billing. Do not store card data in Church OS.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional for future Stripe.js/client-side enhancements. Current v0 redirects through backend-created Checkout Sessions.
VITE_STRIPE_PUBLISHABLE_KEY=

# Clerk authentication (required for sign-in)
# Get these from dashboard.clerk.com -> your app -> Configure -> API keys.
# The publishable key goes in BOTH CLERK_PUBLISHABLE_KEY and VITE_CLERK_PUBLISHABLE_KEY.
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
VITE_CLERK_PUBLISHABLE_KEY=

# Square live giving (webhook integration planned)
# Get these from developer.squareup.com -> your application (Production mode):
#   Access Token: Credentials -> Production Access Token
#   Signature key: Webhooks -> Subscriptions -> your subscription
SQUARE_ACCESS_TOKEN=
SQUARE_WEBHOOK_SIGNATURE_KEY=
# Must exactly match the URL configured in the Square webhook subscription.
SQUARE_WEBHOOK_NOTIFICATION_URL=

# Google OAuth / OpenID Connect
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/auth/oauth/google/callback

# Sign in with Apple
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Store the PEM as a single env value; escaped \n sequences are supported.
APPLE_PRIVATE_KEY=
APPLE_REDIRECT_URI=http://localhost:8080/api/auth/oauth/apple/callback
